# Compiled MEX files (platform-specific binaries)
*.mex*
*.mexw32
*.mexw64
*.mexmaci64
*.mexglx

# Simulink generated code and binaries
*.slxc
slprj/

# Autosave files (MATLAB creates these automatically)
*.asv

# Autosave directory
autosave/

# Published output (from Publish to HTML/PDF feature)
html/

# Deployment Tool output
*.ctf
*.prj

# Profiler output
*.mlprofdata

# Figure files (usually regenerated by scripts)
*.fig

# Workspace saves (binary, not human-readable)
*.mat

# Simulink simulation output
*.slx.r*

# MATLAB preference/cache directories
*.matlabprefs.mat

# Code generation output
codegen/